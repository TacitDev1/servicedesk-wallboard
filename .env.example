# Live Jira mode only. The demo needs none of this.
# Copy to .env (git-ignored) for server.js, or set the same names as
# environment variables in your Netlify site settings.

# Your Jira Cloud site, no trailing slash.
JIRA_SITE=https://<your-site>.atlassian.net

# The two Jira Service Management project keys to show, comma separated.
# They must match the keys in CONFIG.clients at the top of index.html.
JIRA_PROJECTS=BRW,OSU

# Custom field IDs of the SLA fields and the request type (look them up in
# Jira: Settings > Issues > Custom fields, or GET /rest/api/3/field).
# They look like customfield_ followed by digits.
JIRA_FIELD_SLA_RESOLUTION=customfield_XXXXX
JIRA_FIELD_SLA_FIRST_RESPONSE=customfield_XXXXX
# Optional: shows the request type next to the summary.
JIRA_FIELD_REQUEST_TYPE=

# Optional, server.js on your own machine only: sign every API call in with
# this account, so the page needs no sign-in. Leave empty on any public deploy;
# there, each person signs in on the page with their own API token.
JIRA_EMAIL=
JIRA_API_TOKEN=

# Optional
# PORT=8642
# STATS_BUDGET_MS=4000
